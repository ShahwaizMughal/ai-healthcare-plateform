PORT=5000

MONGO_URI=mongodb://localhost:27017/healthcare-platform
# For MongoDB Atlas, use: mongodb+srv://<user>:<password>@cluster.mongodb.net/healthcare-platform

JWT_SECRET=generate_a_long_random_secret_here_minimum_32_chars

CLIENT_URL=http://localhost:5173
# In production, use the deployed Vercel URL: https://your-app.vercel.app

# Email — use Mailtrap (https://mailtrap.io) for development, Gmail for production
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
