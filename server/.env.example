PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-healthcare
# For MongoDB Atlas, use: mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-healthcare

JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
JWT_EXPIRE=30d
NODE_ENV=development

CLIENT_URL=http://localhost:5173
# In production, use the deployed Vercel URL: https://your-app.vercel.app

# Email — use Mailtrap (https://mailtrap.io) for development, Gmail for production
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
